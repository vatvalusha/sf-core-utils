    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Retention_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Retention_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>TargetObject__c</fields>
        <fields>RetentionAge__c</fields>
        <fields>RetentionUnit__c</fields>
        <fields>Active__c</fields>
        <label>Retention Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Configuration object for data retention rules that define how and when old data should be deleted from the organization.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>TargetObject__c</fullName>
        <description>API name of the sObject to apply retention rules to</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the API name of the sObject (e.g., Account, Contact, Custom_Object__c)</inlineHelpText>
        <label>Target Object</label>
        <length>255</length>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RetentionAge__c</fullName>
        <description>Number of units (days/months/years) after which data should be deleted</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the number of days, months, or years after which data should be deleted</inlineHelpText>
        <label>Retention Age</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RetentionUnit__c</fullName>
        <description>Unit of time for retention age (Day, Month, Year)</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the unit of time for the retention age</inlineHelpText>
        <label>Retention Unit</label>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Day</fullName>
                    <default>false</default>
                    <label>Day</label>
                </value>
                <value>
                    <fullName>Month</fullName>
                    <default>true</default>
                    <label>Month</label>
                </value>
                <value>
                    <fullName>Year</fullName>
                    <default>false</default>
                    <label>Year</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>DateFieldAPI__c</fullName>
        <defaultValue>"CreatedDate"</defaultValue>
        <description>API name of the date field to use for retention calculations</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the API name of the date/datetime field to use for retention calculations. Defaults to CreatedDate if not specified.</inlineHelpText>
        <label>Date Field API</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates if the retention rule is active and should be processed</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to enable this retention rule for processing</inlineHelpText>
        <label>Active</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Simulate__c</fullName>
        <defaultValue>true</defaultValue>
        <description>When checked, records will be identified but not actually deleted</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to run in simulation mode - records will be identified but not deleted</inlineHelpText>
        <label>Simulate</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>HardDelete__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When checked, records will be permanently deleted (not sent to recycle bin)</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to permanently delete records (bypass recycle bin). Use with caution!</inlineHelpText>
        <label>Hard Delete</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>RunMethod__c</fullName>
        <description>Determines how the retention rule is executed</description>
        <externalId>false</externalId>
        <inlineHelpText>Select how this retention rule should be executed</inlineHelpText>
        <label>Run Method</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Scheduled</fullName>
                    <default>true</default>
                    <label>Scheduled</label>
                </value>
                <value>
                    <fullName>OnDemand</fullName>
                    <default>false</default>
                    <label>On Demand</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>BatchFrequency__c</fullName>
        <description>Frequency at which scheduled retention rules should execute</description>
        <externalId>false</externalId>
        <inlineHelpText>Select how frequently this retention rule should run when scheduled</inlineHelpText>
        <label>Batch Frequency</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Daily</fullName>
                    <default>false</default>
                    <label>Daily</label>
                </value>
                <value>
                    <fullName>Weekly</fullName>
                    <default>true</default>
                    <label>Weekly</label>
                </value>
                <value>
                    <fullName>Monthly</fullName>
                    <default>false</default>
                    <label>Monthly</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>RunTimeGMT__c</fullName>
        <description>Time in GMT when scheduled retention rules should execute</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the time in GMT when scheduled retention rules should execute (e.g., 02:00:00.000Z)</inlineHelpText>
        <label>Run Time (GMT)</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Time</type>
    </fields>
    <fields>
        <fullName>FilterCondition__c</fullName>
        <description>Optional SOQL WHERE clause fragment to filter records for deletion</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter additional SOQL WHERE conditions to filter records (e.g., Status = 'Inactive' AND Type = 'Archive'). Do not include WHERE keyword.</inlineHelpText>
        <label>Filter Condition</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>BatchChunkSize__c</fullName>
        <defaultValue>200</defaultValue>
        <description>Number of records to process in each batch chunk</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the number of records to process in each batch chunk (default: 200, max: 2000)</inlineHelpText>
        <label>Batch Chunk Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RecordLimitPerRun__c</fullName>
        <defaultValue>10000</defaultValue>
        <description>Maximum number of records to process in a single retention run</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the maximum number of records to process in a single retention run (default: 10,000)</inlineHelpText>
        <label>Record Limit per Run</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>HandleFiles__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When checked, special handling will be applied for ContentDocument and ContentVersion objects</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to enable special handling for Salesforce Files (ContentDocument/ContentVersion)</inlineHelpText>
        <label>Handle Files</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>HandleAttachments__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When checked, special handling will be applied for legacy Attachment objects</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to enable special handling for legacy Attachments</inlineHelpText>
        <label>Handle Attachments</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Retention</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>TargetObject__c</columns>
        <columns>RetentionAge__c</columns>
        <columns>RetentionUnit__c</columns>
        <columns>Active__c</columns>
        <columns>RunMethod__c</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All Retention Rules</label>
    </listViews>
    <listViews>
        <fullName>Active_Retention_Rules</fullName>
        <columns>NAME</columns>
        <columns>TargetObject__c</columns>
        <columns>RetentionAge__c</columns>
        <columns>RetentionUnit__c</columns>
        <columns>RunMethod__c</columns>
        <columns>BatchFrequency__c</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Active__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Active Retention Rules</label>
    </listViews>
    <nameField>
        <label>Retention Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Retentions</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Consonant</startsWith>
    <visibility>Public</visibility>
    <validationRules>
        <fullName>Retention_Age_Must_Be_Positive</fullName>
        <active>true</active>
        <description>Ensures that retention age is always a positive number</description>
        <errorConditionFormula>RetentionAge__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>RetentionAge__c</errorDisplayField>
        <errorMessage>Retention age must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Batch_Size_Reasonable_Limit</fullName>
        <active>true</active>
        <description>Ensures batch chunk size is within reasonable limits (1-2000)</description>
        <errorConditionFormula>AND(
  NOT(ISBLANK(BatchChunkSize__c)),
  OR(
    BatchChunkSize__c &lt; 1,
    BatchChunkSize__c &gt; 2000
  )
)</errorConditionFormula>
        <errorDisplayField>BatchChunkSize__c</errorDisplayField>
        <errorMessage>Batch chunk size must be between 1 and 2000</errorMessage>
    </validationRules>
</CustomObject>
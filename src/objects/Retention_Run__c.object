    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Retention_Run_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Retention_Run_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>Retention__c</fields>
        <fields>Status__c</fields>
        <fields>Found__c</fields>
        <fields>Deleted__c</fields>
        <label>Retention Run Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Log object that tracks the execution details and results of retention rule runs.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Retention__c</fullName>
        <description>Reference to the retention rule that was executed</description>
        <externalId>false</externalId>
        <label>Retention</label>
        <referenceTo>Retention__c</referenceTo>
        <relationshipLabel>Retention Runs</relationshipLabel>
        <relationshipName>Retention_Runs</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Current status of the retention run execution</description>
        <externalId>false</externalId>
        <inlineHelpText>Status of the retention run execution</inlineHelpText>
        <label>Status</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In Progress</fullName>
                    <default>true</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>Aborted</fullName>
                    <default>false</default>
                    <label>Aborted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Found__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Number of records found that match the retention criteria</description>
        <externalId>false</externalId>
        <inlineHelpText>Total number of records identified for deletion/processing</inlineHelpText>
        <label>Found</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Deleted__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Number of records successfully deleted</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of records successfully deleted (0 for simulation runs)</inlineHelpText>
        <label>Deleted</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Errors__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Number of records that encountered errors during processing</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of records that failed to process due to errors</inlineHelpText>
        <label>Errors</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SampleIds__c</fullName>
        <description>Sample record IDs that were processed (comma-separated list of up to 10 IDs)</description>
        <externalId>false</externalId>
        <inlineHelpText>Sample record IDs from this retention run for auditing purposes</inlineHelpText>
        <label>Sample IDs</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>ReportFileId__c</fullName>
        <description>ID of the ContentDocument containing the detailed CSV report for this run</description>
        <externalId>false</externalId>
        <inlineHelpText>ID of the generated CSV report file containing detailed execution results</inlineHelpText>
        <label>Report File ID</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>StartedAt__c</fullName>
        <description>Date and time when the retention run started</description>
        <externalId>false</externalId>
        <inlineHelpText>Timestamp when the retention run execution began</inlineHelpText>
        <label>Started At</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>FinishedAt__c</fullName>
        <description>Date and time when the retention run completed</description>
        <externalId>false</externalId>
        <inlineHelpText>Timestamp when the retention run execution finished</inlineHelpText>
        <label>Finished At</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ErrorDetails__c</fullName>
        <description>Detailed error information if the retention run failed</description>
        <externalId>false</externalId>
        <inlineHelpText>Detailed error information and stack traces from failed retention runs</inlineHelpText>
        <label>Error Details</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Retention Run</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Retention__c</columns>
        <columns>Status__c</columns>
        <columns>Found__c</columns>
        <columns>Deleted__c</columns>
        <columns>Errors__c</columns>
        <columns>StartedAt__c</columns>
        <columns>FinishedAt__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Retention Runs</label>
    </listViews>
    <listViews>
        <fullName>Recent_Retention_Runs</fullName>
        <columns>NAME</columns>
        <columns>Retention__c</columns>
        <columns>Status__c</columns>
        <columns>Found__c</columns>
        <columns>Deleted__c</columns>
        <columns>Errors__c</columns>
        <columns>StartedAt__c</columns>
        <columns>FinishedAt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>LAST_N_DAYS:30</value>
        </filters>
        <label>Recent Retention Runs (30 days)</label>
    </listViews>
    <listViews>
        <fullName>Failed_Retention_Runs</fullName>
        <columns>NAME</columns>
        <columns>Retention__c</columns>
        <columns>Status__c</columns>
        <columns>Found__c</columns>
        <columns>Deleted__c</columns>
        <columns>Errors__c</columns>
        <columns>StartedAt__c</columns>
        <columns>FinishedAt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Failed</value>
        </filters>
        <label>Failed Retention Runs</label>
    </listViews>
    <nameField>
        <displayFormat>RUN-{00000000}</displayFormat>
        <label>Retention Run Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Retention Runs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Consonant</startsWith>
    <visibility>Public</visibility>
</CustomObject>